# Сгенерировано space-lab, руками не редактировать: правки уйдут при
# следующем up. Настройки — в space-lab.yaml.
name: space-lab-{{ .Cfg.Object.Name }}

services:
  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_PASSWORD: lab
      POSTGRES_DB: khorost
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d khorost"]
      interval: 3s
      retries: 20

  redis:
    image: redis:7-alpine

  migrate:
    image: {{ .Cfg.Platform.Registry }}/migrate:{{ .Cfg.Platform.Version }}
    command: ["up"]
    environment:
      KHOROST_STAND: local
      KHOROST_DATABASE_URL: postgres://postgres:lab@postgres:5432/khorost?sslmode=disable
    depends_on:
      postgres:
        condition: service_healthy

  platform-api:
    image: {{ .Cfg.Platform.Registry }}/platform-api:{{ .Cfg.Platform.Version }}
    environment:
      KHOROST_STAND: local
      KHOROST_DATABASE_URL: postgres://postgres:lab@postgres:5432/khorost?sslmode=disable
      KHOROST_API_TOKEN: {{ .APIToken }}
      KHOROST_GATEWAY_TOKEN: {{ .GatewayToken }}
      {{- if .ObjectID }}
      KHOROST_SHOWCASE_OBJECT_ID: {{ .ObjectID }}
      {{- end }}
      # Порог молчания — минута: столько же, сколько на стенде. Занижать
      # локально значило бы получать signal_lost там, где центр показал бы
      # online, то есть расхождение вердикта на ровном месте.
      KHOROST_RUNTIME_SIGNAL_THRESHOLD: 60s
    ports: ["{{ .Cfg.Ports.API }}:8080"]
    depends_on:
      migrate:
        condition: service_completed_successfully

  platform-worker:
    image: {{ .Cfg.Platform.Registry }}/platform-worker:{{ .Cfg.Platform.Version }}
    environment:
      KHOROST_STAND: local
      KHOROST_DATABASE_URL: postgres://postgres:lab@postgres:5432/khorost?sslmode=disable
      KHOROST_RUNTIME_SIGNAL_THRESHOLD: 60s
      KHOROST_NATS_URL: nats://nats:4222
      # Имя своё, не то что на стендах: полигон не должен путать свои
      # события с чужими, если когда-нибудь окажется в одной сети со стендом.
      KHOROST_NATS_STREAM: KHOROST_SPACE_LOCAL
      # Воркер по умолчанию просит три реплики стрима (прод-настройка), а
      # NATS в полигоне один узел — с тремя репликами создание стрима не
      # пройдёт. Платформа переменную пока не читает (правка отдельная,
      # летит следом) — до тех пор строка просто игнорируется, а как
      # приедет, стек сразу заработает без повторной правки compose.
      KHOROST_NATS_REPLICAS: 1
    depends_on:
      migrate:
        condition: service_completed_successfully
      nats:
        condition: service_healthy

  # Официальный образ, alpine, версия закреплена минорно — не latest: иначе
  # вчерашний зелёный up сегодня необъясним.
  nats:
    image: nats:2.10-alpine
    # -js включает JetStream: без него воркер не создаст стрим. -m поднимает
    # HTTP-монитор — на нём и держится проба ниже.
    command: ["-js", "-m", "8222"]
    healthcheck:
      # Проверено фактически (docker run + wget внутри контейнера): в образе
      # nats:2.10-alpine есть только busybox wget, curl нет. /healthz —
      # штатный эндпоинт монитора, отвечает {"status":"ok"} после старта.
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8222/healthz"]
      interval: 2s
      retries: 20

  # Тег берётся из Platform.IssuerVersion, а не Platform.Version: issuer
  # собирается из самого space-lab и версионируется отдельным циклом —
  # версия платформы для него ничего не значит.
  dev-issuer:
    image: ghcr.io/khorost-space/space-lab-issuer:{{ .Cfg.Platform.IssuerVersion }}
    environment:
      KHOROST_ISSUER_URL: http://dev-issuer:8081
      KHOROST_ISSUER_ADDR: ":8081"
      KHOROST_TOKEN_NAMESPACE: {{ .Namespace }}
      KHOROST_TOKEN_SERVICEACCOUNT: {{ .ServiceAccount }}
    volumes:
      - identity:/var/run/khorost/identity
    # Порт публикуется наружу как и у остальных служб: раз в конфигурации
    # есть Ports.Issuer, поле должно на что-то влиять, иначе проверка
    # уникальности портов сторожит несуществующее значение.
    ports: ["{{ .Cfg.Ports.Issuer }}:8081"]
    healthcheck:
      # Проба через сам бинарник, а не curl: образ на scratch, curl в нём
      # нет. -healthcheck делает одиночный GET /healthz к себе и код выхода.
      test: ["CMD", "/issuer", "-healthcheck"]
      interval: 2s
      retries: 20

  student-gateway:
    image: {{ .Cfg.Platform.Registry }}/student-gateway:{{ .Cfg.Platform.Version }}
    environment:
      KHOROST_STAND: local
      KHOROST_GATEWAY_ISSUERS: http://dev-issuer:8081
      KHOROST_GATEWAY_AUDIENCE: khorost-student-gateway
      KHOROST_WORLD_CORE_URL: http://platform-api:8080
      KHOROST_GATEWAY_TOKEN: {{ .GatewayToken }}
      {{- if .ObjectID }}
      # Пустое отображение лучше отображения с пустым полем: до второй
      # фазы object_id не существует (его выдаёт платформа), а служба на
      # первой фазе всё равно не поднимается — писать сюда нечего.
      KHOROST_GATEWAY_BINDINGS: http://dev-issuer:8081|{{ .Namespace }}|{{ .ServiceAccount }}|{{ .ObjectID }}|local
      {{- end }}
      # Имя переменной — KHOROST_REDIS_URL: loadRedisConfig платформы читает
      # именно его, KHOROST_REDIS_ADDR она не знает вовсе и откажет в
      # старте с «настройки Redis не заданы», хотя значение подставлено.
      KHOROST_REDIS_URL: redis:6379
    ports: ["{{ .Cfg.Ports.Gateway }}:8080"]
    depends_on:
      dev-issuer:
        condition: service_healthy

  registry:
    image: registry:3
    ports: ["{{ .Cfg.Ports.Registry }}:5000"]

  spacecraft:
    image: {{ .SpacecraftImage }}
    environment:
      KHOROST_GATEWAY_URL: http://student-gateway:8080
      KHOROST_RELEASE_DIGEST: {{ .SpacecraftDigest }}
      KHOROST_HTTP_ADDR: ":{{ .Cfg.Spacecraft.HealthPort }}"
    volumes:
      - identity:/var/run/khorost/identity:ro
    ports: ["{{ .Cfg.Ports.Health }}:{{ .Cfg.Spacecraft.HealthPort }}"]
    # Эталонный аппарат читает файл токена при загрузке конфигурации и
    # падает, если его ещё нет (vega-0/internal/config, Load). Токен в общий
    # том пишет dev-issuer — без этой зависимости аппарат, стартовавший
    # первым, отказывает и остаётся лежать без перезапуска.
    depends_on:
      dev-issuer:
        condition: service_healthy

volumes:
  # Права уже решены в Dockerfile.issuer: каталог лежит в образе с
  # владельцем 65532, docker копирует владельца в том при первом
  # монтировании (copy-up). Ни user:, ни init-контейнер здесь не нужны.
  identity:
